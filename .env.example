# Railway provides PORT automatically. Mount a Volume at /data and retain this value.
PORT=3000
DATA_DIR=./data

# Required in production. Comma-separate values to rotate keys without downtime.
RAG_BUCKET_API_KEYS=replace-with-a-long-random-secret

# Public URL without a trailing slash. Used in machine-readable catalogues.
PUBLIC_BASE_URL=http://localhost:3000
